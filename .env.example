# 管理密码（必填，使用长随机密码） / Admin password (required, use a long random password)
ADMIN_PASSWORD=
# 监听端口 / Listening port
PORT=8787
# 容器监听地址 / Container listening address
HOST=0.0.0.0
# Git 仓库 HTTPS 地址，不含凭据 / Git HTTPS remote, without credentials
GIT_REMOTE=https://github.com/kyl619031313-sketch/personal-site.git
# GitHub 细粒度令牌（必填，不要提交） / GitHub fine-grained token (required, never commit)
GITHUB_TOKEN=
# Git 提交者姓名（必填） / Git author name (required)
GIT_AUTHOR_NAME=
# Git 提交者邮箱（必填，可使用 GitHub noreply 邮箱） / Git author email (required, GitHub noreply allowed)
GIT_AUTHOR_EMAIL=
# 信任反向代理请求头，仅在端口受保护时开启 / Trust proxy headers only with a protected admin port
ADMIN_TRUST_PROXY=0

---
import QuietCopy from '../components/QuietCopy.astro';
import { internalHref } from '../utils/links';
import Layout from '../layouts/MainLayout.astro';
import Hero from '../components/sections/landing/HeroSection.astro';
import Services from '../components/sections/features/FeaturesGeneral.astro';
import FAQ from '../components/sections/misc/FAQ.astro';
import CTA from '../components/sections/misc/ContactSection.astro';
import copy from '../data/copy';
---
<Layout person><Hero /><section class="section who grid-two" data-reveal><div><p class="eyebrow"><QuietCopy value={copy.home.whoLabel} /></p><h2><QuietCopy value={copy.home.whoTitle} /></h2></div><div><p class="lead"><QuietCopy value={copy.home.whoText} /></p><a class="text-link" href={internalHref('/about')}><QuietCopy value={copy.home.whoLink} /><span aria-hidden="true">↗</span></a></div></section><Services /><section class="section"><div class="section-heading" data-reveal><p class="eyebrow"><QuietCopy value={copy.home.casesLabel} /></p><h2><QuietCopy value={copy.home.casesTitle} /></h2><p><QuietCopy value={copy.home.casesNote} /></p></div><div class="case-grid">{copy.cases.map(item => <article class="case-card" data-reveal><p class="eyebrow"><QuietCopy value={item.tag} /></p><div class="metric"><QuietCopy value={item.metric} /></div><p class="metric-label"><QuietCopy value={item.metricLabel} /></p><h3><QuietCopy value={item.title} /></h3><p><QuietCopy value={item.description} /></p><div class="case-detail"><QuietCopy value={item.detail} /></div></article>)}</div></section><FAQ /><CTA /></Layout>

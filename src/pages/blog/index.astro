---
import Layout from '../../layouts/MainLayout.astro';
import { internalHref } from '../../utils/links';
import { getPostGroups, formatPostDate } from '../../utils/blog';
const groups = await getPostGroups();
---

<Layout title="博客" description="博客文章与记录。">
  <section class="page-hero" data-reveal>
    <h1>博客</h1>
  </section>
  <section class="section blog-list" aria-label="博客文章">
    {groups.length === 0 ? (
      <p class="blog-empty" data-reveal>
        暂无文章。
      </p>
    ) : (
      groups.map(group => (
        <section class="blog-group">
          {group.label && (
            <h2 class="eyebrow blog-group-label">{group.label}</h2>
          )}
          {group.posts.map(post => (
            <article class="blog-entry" data-reveal>
              <time datetime={post.data.date.toISOString().slice(0, 10)}>
                {formatPostDate(post.data.date)}
              </time>
              <h2>
                <a href={internalHref(`/blog/${post.id}`)}>{post.data.title}</a>
              </h2>
              <p>{post.data.summary}</p>
              <a
                class="text-link"
                href={internalHref(`/blog/${post.id}`)}
                aria-label={`阅读全文：${post.data.title}`}
              >
                阅读全文 <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </section>
      ))
    )}
  </section>
</Layout>

<style>
  .blog-group + .blog-group {
    margin-top: 4rem;
  }
  .blog-group-label {
    margin-bottom: 1.5rem;
    font-weight: 500;
  }
</style>
